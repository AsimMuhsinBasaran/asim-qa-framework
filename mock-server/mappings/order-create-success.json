{
  "priority": 10,
  "request": {
    "method": "POST",
    "url": "/orders",
    "bodyPatterns": [
      { "matchesJsonPath": "$.userId" },
      { "matchesJsonPath": "$[?(@.items.size() > 0)]" },
      { "matchesJsonPath": "$[?(@.items[0].productId == 1)]" }
    ]
  },
  "response": {
    "status": 201,
    "headers": { "Content-Type": "application/json" },
    "jsonBody": {
      "orderId": 501,
      "userId": "{{jsonPath request.body '$.userId'}}",
      "status": "PENDING",
      "total": 129.98,
      "items": [
        { "productId": 1, "name": "Wireless Headphones", "quantity": 1, "price": 79.99 },
        { "productId": 2, "name": "Running Shoes", "quantity": 1, "price": 49.99 }
      ],
      "createdAt": "2025-01-01T10:00:00Z"
    },
    "transformers": ["response-template"]
  }
}
